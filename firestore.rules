rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return hasProfile() && userDoc().status == 'ativo';
    }

    function role() {
      return userDoc().role;
    }

    // Compatível com perfil legado "administrador"
    function isGeneralAdmin() {
      return isActiveUser() && (role() == 'administrador_geral' || role() == 'administrador');
    }

    function isSchoolAdmin() {
      return isActiveUser() && role() == 'administrador_escola';
    }

    function isOperator() {
      return isActiveUser() && role() == 'operador';
    }

    function isGuardian() {
      return isActiveUser() && role() == 'responsavel';
    }

    function isStaff() {
      return isGeneralAdmin() || isSchoolAdmin() || isOperator();
    }

    function sameSchool(schoolId) {
      return isActiveUser() && userDoc().schoolId == schoolId;
    }

    function systemInitialized() {
      return exists(/databases/$(database)/documents/settings/system)
        && get(/databases/$(database)/documents/settings/system).data.initialized == true;
    }

    function validRole(value) {
      return value in [
        'administrador_geral',
        'administrador_escola',
        'operador',
        'responsavel',
        'administrador'
      ];
    }

    function canAssignRole(value) {
      return isGeneralAdmin()
        || (isSchoolAdmin() && value in ['operador', 'responsavel']);
    }

    match /settings/system {
      allow read: if true;
      allow create: if signedIn() && !systemInitialized()
        && request.resource.data.initialized == true
        && request.resource.data.firstAdminUid == request.auth.uid;
      allow update: if isGeneralAdmin();
    }

    match /schools/{schoolId} {
      allow read: if isGeneralAdmin()
        || (isStaff() && sameSchool(schoolId))
        || (isGuardian() && sameSchool(schoolId));

      allow create: if (signedIn() && !systemInitialized()) || isGeneralAdmin();

      allow update: if isGeneralAdmin()
        || (isSchoolAdmin() && sameSchool(schoolId));

      allow delete: if false;
    }

    match /guardians/{guardianId} {
      allow read: if isGeneralAdmin()
        || ((isSchoolAdmin() || isOperator()) && resource.data.schoolId == userDoc().schoolId)
        || (isGuardian() && resource.data.userId == request.auth.uid);

      allow create: if (isGeneralAdmin() || isSchoolAdmin())
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId.size() > 0
        && request.resource.data.status in ['ativo', 'inativo']
        && (isGeneralAdmin() || request.resource.data.schoolId == userDoc().schoolId);

      allow update: if (isGeneralAdmin() || isSchoolAdmin())
        && request.resource.data.schoolId == resource.data.schoolId
        && (isGeneralAdmin() || resource.data.schoolId == userDoc().schoolId);

      allow delete: if isGeneralAdmin() && resource.data.isDemo == true;
    }

    match /students/{studentId} {
      allow read: if isGeneralAdmin()
        || ((isSchoolAdmin() || isOperator()) && resource.data.schoolId == userDoc().schoolId)
        || (isGuardian() && request.auth.uid in resource.data.guardianUserIds);

      allow create: if (isGeneralAdmin() || isSchoolAdmin())
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['ativo', 'inativo']
        && request.resource.data.guardianIds is list
        && request.resource.data.guardianIds.size() > 0
        && (isGeneralAdmin() || request.resource.data.schoolId == userDoc().schoolId)
        || (
          isGuardian()
          && request.resource.data.schoolId == userDoc().schoolId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.status == 'ativo'
          && request.resource.data.guardianIds is list
          && request.resource.data.guardianIds.size() == 1
          && request.resource.data.guardianUserIds is list
          && request.resource.data.guardianUserIds.size() == 1
          && request.auth.uid in request.resource.data.guardianUserIds
          && exists(/databases/$(database)/documents/guardians/$(request.resource.data.guardianIds[0]))
          && get(/databases/$(database)/documents/guardians/$(request.resource.data.guardianIds[0])).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/guardians/$(request.resource.data.guardianIds[0])).data.schoolId == userDoc().schoolId
          && get(/databases/$(database)/documents/guardians/$(request.resource.data.guardianIds[0])).data.status == 'ativo'
        );

      allow update: if (isGeneralAdmin() || isSchoolAdmin())
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.guardianIds is list
        && request.resource.data.guardianIds.size() > 0
        && request.resource.data.status in ['ativo', 'inativo']
        && (isGeneralAdmin()
          || (resource.data.schoolId == userDoc().schoolId
            && request.resource.data.schoolId == resource.data.schoolId))
        || (
          isGuardian()
          && request.auth.uid in resource.data.guardianUserIds
          && request.auth.uid in request.resource.data.guardianUserIds
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.schoolId == userDoc().schoolId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.status in ['ativo', 'inativo']
        );

      allow delete: if isGeneralAdmin() && resource.data.isDemo == true;
    }

    match /users/{userId} {
      allow read: if isGeneralAdmin()
        || (isSchoolAdmin() && resource.data.schoolId == userDoc().schoolId)
        || (isOperator() && resource.data.schoolId == userDoc().schoolId)
        || (signedIn() && request.auth.uid == userId);

      allow create: if
        (signedIn()
          && !systemInitialized()
          && request.auth.uid == userId
          && request.resource.data.role in ['administrador_geral', 'administrador']
          && request.resource.data.status == 'ativo')
        || (canAssignRole(request.resource.data.role)
          && request.resource.data.schoolId is string
          && request.resource.data.schoolId.size() > 0
          && validRole(request.resource.data.role)
          && (isGeneralAdmin()
            || request.resource.data.schoolId == userDoc().schoolId));

      allow update: if isGeneralAdmin()
        || (isSchoolAdmin()
          && resource.data.schoolId == userDoc().schoolId
          && request.resource.data.schoolId == resource.data.schoolId
          && request.resource.data.role in ['operador', 'responsavel', 'administrador_escola']
          && !(resource.data.role in ['administrador_geral', 'administrador']))
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'phone', 'updatedAt']));

      allow delete: if isGeneralAdmin() && resource.data.isDemo == true;
    }
  }
}
