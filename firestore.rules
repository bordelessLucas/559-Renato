rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return hasProfile() && userDoc().status == 'ativo';
    }

    function isAdmin() {
      return isActiveUser() && userDoc().role == 'administrador';
    }

    function isOperator() {
      return isActiveUser() && userDoc().role == 'operador';
    }

    function sameSchool(schoolId) {
      return isActiveUser() && userDoc().schoolId == schoolId;
    }

    function systemInitialized() {
      return exists(/databases/$(database)/documents/settings/system)
        && get(/databases/$(database)/documents/settings/system).data.initialized == true;
    }

    match /settings/system {
      allow read: if signedIn();
      allow create: if signedIn() && !systemInitialized()
        && request.resource.data.initialized == true;
      allow update: if isAdmin();
    }

    match /schools/{schoolId} {
      allow read: if isAdmin() || (isOperator() && sameSchool(schoolId));
      allow create: if (signedIn() && !systemInitialized()) || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || (isOperator() && resource.data.schoolId == userDoc().schoolId)
        || (signedIn() && request.auth.uid == userId);

      allow create: if
        (signedIn()
          && !systemInitialized()
          && request.auth.uid == userId
          && request.resource.data.role == 'administrador'
          && request.resource.data.status == 'ativo')
        || isAdmin();

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'phone', 'updatedAt']));

      allow delete: if false;
    }

    match /guardians/{guardianId} {
      allow read: if isAdmin()
        || (isOperator() && resource.data.schoolId == userDoc().schoolId);

      allow create: if isAdmin()
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId.size() > 0;

      allow update: if isAdmin()
        && (!('schoolId' in request.resource.data)
          || request.resource.data.schoolId == resource.data.schoolId
          || isAdmin());

      allow delete: if false;
    }
  }
}
